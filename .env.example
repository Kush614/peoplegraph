# Neo4j Aura Free — from the Aura console "Connect" panel
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=          # leave blank for the server default; Aura Free names it after the instance id (e.g. c071d13f)

# Anthropic API key (used ONLY for ingest-time extraction and /draft)
LLM_API_KEY=
LLM_MODEL=claude-opus-5

# Optional: the mailbox owner's address. If unset, ingest picks the most frequent address.
# Leave blank when using scripts/fetch_google.py (it records the owner in data/owner.txt). Synthetic data uses kush@lumenlabs.io.
MY_EMAIL=
