{
  "mcpServers": {
    "neo4j-peoplegraph": {
      "command": "uvx",
      "args": ["-p", "3.12", "mcp-neo4j-cypher@0.6.0", "--transport", "stdio"],
      "env": {
        "NEO4J_URI": "neo4j+s://xxxxxxxx.databases.neo4j.io",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "<password>",
        "NEO4J_DATABASE": "neo4j"
      }
    }
  }
}
